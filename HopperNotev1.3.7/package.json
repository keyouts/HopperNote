{
  "name": "hopper-note",
  "version": "1.3.7",
  "main": "src/main/main.js",
  "private": true,
  "author": "KeyOuts",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "42.1.0",
    "electron-builder": "26.8.1"
  },
  "build": {
    "appId": "com.hopper.note",
    "productName": "Hopper Note",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "package.json",
      "index.html",
      "src/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "tar": "^7.5.2"
  }
}