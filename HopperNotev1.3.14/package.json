{
  "name": "hopper-note",
  "version": "1.3.14",
  "main": "src/main/main.js",
  "private": true,
  "author": "KeyOuts",
  "scripts": {
    "start": "electron .",
    "lint": "node --check src/main/main.js && node --check src/main/preload.js && node --check src/main/data-store.js && node --check src/main/security.js && node --check src/main/app-protocol.js && node --check src/shared/validation.js && node --check src/shared/highlight-transfer.js && node --check src/shared/ui-settings.js && node --check src/renderer/app.js",
    "test": "node --test test/*.test.js",
    "check": "npm run lint && npm test",
    "build": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.hopper.note",
    "productName": "Hopper Note",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "package.json",
      "index.html",
      "src/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Hopper Note",
      "runAfterFinish": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "asar": true,
    "compression": "maximum",
    "artifactName": "Hopper-Note-Setup-${version}.${ext}",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    }
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "tar": "7.5.22"
  },
  "description": "A local-first desktop journal for highlights and long-form notes.",
  "devDependencies": {
    "electron": "42.10.1",
    "electron-builder": "26.15.7"
  }
}
